# Настройки личного кабинета. Скопируй этот файл как .env.local и заполни.
# Сам .env.local в git не попадает (.gitignore содержит *.local), поэтому
# ключи можно хранить прямо здесь.

# Supabase → Project Settings → Data API
# URL проекта: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Там же → API Keys → anon public key.
# Это публичный ключ, он предназначен для браузера; доступ к данным
# ограничивают политики RLS в supabase/schema.sql, а не сам ключ.
VITE_SUPABASE_ANON_KEY=

# Куда приводить ссылку из письма «восстановить пароль».
# Должен совпадать с Site URL / Redirect URLs в Supabase.
# Значение по умолчанию подходит для локальной разработки.
VITE_SUPABASE_REDIRECT_URL=http://localhost:5174/
